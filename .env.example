# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# Optional: AdSense publisher ID (e.g. ca-pub-0000000000000000). Leave empty to disable.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
# Optional: public contact email shown on /contact. Leave empty to show a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: AdSense ad unit IDs (numeric slot IDs created in your AdSense account).
# A position renders only when NEXT_PUBLIC_ADSENSE_CLIENT and its slot ID are both set.
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
